{
  "version": 1,
  "sdk_version": "0.20.0",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://jgwwmtuvjlmzapwqiabu.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "hpa-reporting-mcp",
      "version": "0.1.0",
      "title": "HPA Reporting"
    },
    "tools": [
      {
        "name": "list_clients",
        "title": "List clients",
        "description": "List clients visible to the signed-in user (id, name, status, slug).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "status": {
              "description": "Filter by client status",
              "type": "string",
              "enum": [
                "active",
                "paused",
                "archived"
              ]
            },
            "limit": {
              "default": 50,
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_client_metrics",
        "title": "Get client source metrics",
        "description": "Aggregate lead/call/funded metrics per client for an optional date range. Returns rows from get_client_source_metrics.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "client_id": {
              "description": "Filter to a single client id.",
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "start_date": {
              "description": "ISO date (YYYY-MM-DD) inclusive.",
              "type": "string"
            },
            "end_date": {
              "description": "ISO date (YYYY-MM-DD) inclusive.",
              "type": "string"
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_top_performers",
        "title": "Get top-performing campaign/adset/ad",
        "description": "Return the top-performing Meta campaign, ad set, and ad by attributed funded dollars for the given clients.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "client_ids": {
              "description": "Optional list of client ids to filter by. Omit for all visible clients.",
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              }
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_recent_leads",
        "title": "List recent leads",
        "description": "List the most recent leads for a client with basic contact and status info.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "client_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "Client id to fetch leads for."
            },
            "limit": {
              "default": 25,
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          "required": [
            "client_id"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
