# Shared secret the Lovable edge function uses to call POST /send and /status
BRIDGE_TOKEN=change-me-to-a-long-random-string

# Lovable edge function URL — format below (project ref shown to you in app settings)
LOVABLE_WEBHOOK_URL=https://YOUR-PROJECT.supabase.co/functions/v1/whatsapp-inbound

# Shared secret the bridge sends as x-bridge-secret (must match WHATSAPP_WEBHOOK_SECRET in Lovable)
WEBHOOK_SECRET=another-long-random-string

# Optional — only change if running multiple bridges
SESSION_LABEL=default